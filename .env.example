# === NVIDIA API (JUST ADD YOUR KEY) ===
# Get your key from https://build.nvidia.com - Nemotron 3 Ultra
NVIDIA_API_KEY=
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TEMPERATURE=0.2
NVIDIA_MAX_TOKENS=2048

# === APP ===
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=change-this-to-random-secret
UPLOAD_DIR=./uploads
DATA_DIR=./data

# === STRIX / SENTINEL ===
STRIX_PATH=D:/hackathon/strix
# Sentinel can also use Nemotron 3 Ultra as Strix LLM: set STRIX_LLM=nvidia/nemotron-3-ultra-550b-a55b and LLM_API_KEY=NVIDIA_API_KEY
STRIX_LLM=nvidia/nemotron-3-ultra-550b-a55b
LLM_API_KEY=
DOCKER_ENABLED=false

# === RISK ENGINE ===
DEFAULT_CURRENCY=INR
EAL_CONFIDENCE=0.95
